# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production/Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/festadeipiccoli

# Option 2: Use individual DB variables (used if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=festadeipiccoli

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Client (React) - stessa publishable key di Clerk
REACT_APP_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
